# Copy to .env and fill in. .env is git-ignored (it holds secrets); in
# production set these as environment variables instead.

# Required. Created and filled by: python scripts/postgres_setup.py
DATABASE_URL=postgresql+psycopg2://smart_class:CHANGE_ME@localhost:5432/smart_classroom

# Required, at least 32 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-value-of-at-least-32-characters

# Code needed to register as an administrator once an admin exists.
ADMIN_REGISTRATION_CODE=change-me

# Web addresses allowed to call the API from a browser (the deployed web
# app), comma separated. localhost is always allowed for development unless
# CORS_ALLOW_LOCALHOST=false.
CORS_ORIGINS=
# CORS_ALLOW_LOCALHOST=false

# TURN relay for live-class audio/video. REQUIRED once deployed: without it,
# students and lecturers on different networks (mobile data, other Wi-Fi)
# connect to the class but cannot see or hear each other. Set ONE option:
#  a) Metered.ca (free plan): dashboard -> TURN Server -> credential -> API key
# METERED_DOMAIN=yourapp.metered.live
# METERED_API_KEY=
#  b) Cloudflare Realtime TURN: TURN key id + API token
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
#  c) Any TURN server (e.g. your own coturn), comma separated URLs
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Only for docker compose (password of the bundled PostgreSQL container).
# POSTGRES_PASSWORD=change-me
