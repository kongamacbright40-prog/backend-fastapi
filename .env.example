# Copy to .env and adjust. .env is git-ignored (it holds secrets).

# Database. Created and filled by: python scripts/postgres_setup.py
# Without this line the backend uses the SQLite file dev.db.
DATABASE_URL=postgresql+psycopg2://smart_class:CHANGE_ME@localhost:5432/smart_classroom

# Long random value, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret

# Code needed to register as an administrator once an admin exists.
ADMIN_REGISTRATION_CODE=change-me
